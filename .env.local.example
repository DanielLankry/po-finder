# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-key

# Vercel Cron authenticates /api/cron/expiry-reminders with this bearer secret.
CRON_SECRET=long-random-cron-secret

# Admin
ADMIN_SECRET=long-random-string

# Payment provider — HYP (YaadPay)
# For local dev, HYP publishes a public test merchant you can drop in:
#   HYP_MASOF=0010131918
#   HYP_PASSP=yaad
#   HYP_API_KEY=7110eda4d09e062aa5e4a390b0a572ac0d2c0220
HYP_MASOF=
HYP_PASSP=
HYP_API_KEY=

# Public site origin — used for HYP success/error/cancel redirect URLs.
# Must match your production domain exactly.
NEXT_PUBLIC_SITE_URL=https://pokarov.co.il
# Public Meta Pixel identifier. Pixel loading remains gated by cookie consent.
NEXT_PUBLIC_META_PIXEL_ID=27527545196939763

# Backup/recovery controls — configure only in protected CI/operator envs.
# Do not put production backup credentials in a local checkout.
PO_FINDER_BACKUP_SOURCE_DB_URL=
PO_FINDER_BACKUP_AGE_RECIPIENTS=
PO_FINDER_BACKUP_DESTINATION_RCLONE=
PO_FINDER_STORAGE_RCLONE_SOURCE=
PO_FINDER_RESTORE_TARGET_DB_URL=
PO_FINDER_RESTORE_AGE_IDENTITY=
PO_FINDER_RESTORE_STORAGE_RCLONE_DESTINATION=
